rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The current app stores shared collections in one document. Require Firebase
    // Authentication for every access until the data is migrated to per-user docs.
    match /cleanerServiceApp/sharedState {
      allow read, write: if request.auth != null;
    }

    // Deny any unexpected collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
